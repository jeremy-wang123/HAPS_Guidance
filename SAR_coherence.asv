%% Calculations for the uncertainty and coherence of radar

% constants
theta = 40; 
%% Linear Temporal Coherence
% Parameters for linear temporal coherence

T_zero = 6 * 24 * 3600;          % coherence reaches zero at 6 days, s
k = 1;                  % sz = k*sy

t = 0:60:(10 * 24 * 3600);       % 10-day simulation, 1-minute spacing
t_days = t/(24*3600);

% Linear temporal coherence
gamma_temporal = max(1 - t/T_zero, 0);

figure;
plot(t_days, gamma_temporal, 'LineWidth', 2);
grid on;
box on;

xlabel('Time (days)');
ylabel('\gamma_{temporal}');
title('Linear Temporal Coherence Decay');

xlim([0 10]);
ylim([0 1]);
xline(6, '--', 'Complete decorrelation');

% Estimate sy and sz from temporal coherence

figure;
hold on;
grid on;
box on;


% The inverse equation is undefined at gamma = 0
valid = gamma_temporal > 0;

sy = NaN(size(t));
sz = NaN(size(t));

sy(valid) = (lambda/(4*pi)) .* ...
    sqrt( ...
    -2 .* log(gamma_temporal(valid)) ./ ...
    (sind(theta).^2 + k.^2 .* cosd(theta).^2) ...
    );

sz(valid) = k .* sy(valid);

% Horizontal displacement spread
plot(t_days, sy, '-', ...
    'LineWidth', 2);

xline(6, 'k:', 'Complete decorrelation', ...
    'HandleVisibility', 'off');

xlabel('Time (days)');
ylabel('RMS Scatterer Displacement (m)');
title('Scatterer Displacement for Linear Coherence Decay');

xlim([0 6]);

%% Temporal coherence vs horizontal RMS scatterer displacement
% Assumption: sz = k*sy

k = [0.25 1 4];

sy = linspace(0,0.12,500);    % horizontal RMS displacement, m
colors = lines(length(k));

figure;
hold on;
grid on;
box on;

for i = 1:length(k)

    sz = k(i).*sy;

    gamma_temporal = exp( ...
        -0.5 .* (4*pi/lambda).^2 .* ...
        (sy.^2 .* sind(theta).^2 + ...
         sz.^2 .* cosd(theta).^2) );

    plot(sy, gamma_temporal, ...
        'LineWidth',2, ...
        'Color',colors(i,:), ...
        'DisplayName',sprintf('k = %.2f',k(i)));
end

xlabel('Horizontal RMS Scatterer Displacement, s_y (m)');
ylabel('\gamma_{temporal}');
title('Temporal Coherence vs. RMS Scatterer Displacement');

xlim([0 max(sy)]);
ylim([0 1]);

legend('Location','northeast');

%% Singular calculations
% Baseline parameter values
c = 299792458; % speed of light, m/s
f = 1.2e9; % cycles/sec
lambda = c/f; % meters

baseline.L         = 20;
baseline.lambda    = lambda;      % m
baseline.dphi      = 5;         % degrees
baseline.NESZ_dB   = -20;       % dB (
baseline.sigma0_dB = -15;       % dB (generally ranges from -5 to -15)
baseline.b_perp    = 200;       % m
baseline.time      = 12*3600;   % seconds

uncertainty = estimate_insar_uncertainty(baseline.L, baseline.lambda, baseline.dphi, baseline.NESZ_dB, baseline.sigma0_dB,baseline.b_perp,baseline.time)


%% Sobol sensitivity analysis using the SAFE Toolbox
clear;
clc;
close all;

% Add SAFE Toolbox
figure_dir = '/Users/jeremywang/Library/CloudStorage/GoogleDrive-jcwang2@caltech.edu/My Drive/HAPS_Guidance/Figures/SAR_uncertainty';
SAFE_directory = '/Users/jeremywang/Documents/MATLAB/SAFE-matlab-main';
addpath(genpath(SAFE_directory));

rng(1);

% Input definitions

parameter_names = { ...
    '\lambda', ...
    'L', ...
    '\Delta\phi', ...
    'NESZ', ...
    '\sigma^0', ...
    'B_\perp', ...
    'Time'};

M = length(parameter_names);

% All inputs are assumed uniformly distributed
distr_fun = { ...
    'unif', ...
    'unif', ...
    'unif', ...
    'unif', ...
    'unif', ...
    'unif', ...
    'unif'};

% Distribution parameters: [minimum maximum]
%
% lambda:      10–30 cm, converted to meters
% L:           1–50 looks
% dphi:        0–5 degrees
% NESZ:       -30 to -15 dB
% sigma0:     -25 to -3 dB
% b_perp:      0–200 m
% time:        6–24 hours, converted to seconds

distr_par = { ...
    [0.10, 0.30], ...
    [1, 50], ...
    [0, 5], ...
    [-30, -15], ...
    [-25, -3], ...
    [0, 200], ...
    [6*3600, 24*3600]};

% Sampling

% Base sample size
N = 5000;

% SAFE initially generates 2N independent samples
X = AAT_sampling( ...
    'lhs', ...
    M, ...
    distr_fun, ...
    distr_par, ...
    2*N);

% Construct the A, B and hybrid C matrices
[XA, XB, XC] = vbsa_resampling(X);

fprintf('Base sample size: %d\n',N);
fprintf('Number of parameters: %d\n',M);
fprintf('Total model evaluations: %d\n',N*(M + 2));

% Run the InSAR uncertainty model

YA = run_insar_model(XA);
YB = run_insar_model(XB);
YC = run_insar_model(XC);

% Check results

if any(~isfinite([YA; YB; YC]))
    error('The model returned NaN or Inf values.');
end

%% Calculate Sobol indices with SAFE

% Si  = first-order indices
% STi = total-order indices
[Si, STi] = vbsa_indices(YA, YB, YC);

% Display results

interaction_indicator = STi - Si;

results = table( ...
    parameter_names', ...
    Si(:), ...
    STi(:), ...
    interaction_indicator(:), ...
    'VariableNames', { ...
    'Parameter', ...
    'FirstOrder', ...
    'TotalOrder', ...
    'TotalMinusFirst'});

results = sortrows(results,'TotalOrder','descend');

disp(results);

%% Plot the indices

figure;

bar([Si(:), STi(:)]);

xticks(1:M);
xticklabels(parameter_names);

ylabel('Sobol index');

legend( ...
    'First order, S_i', ...
    'Total order, S_{T_i}', ...
    'Location','best');

title('InSAR Uncertainty Sensitivity Analysis');

ylim([0, max(1, 1.1*max(STi))]);

grid on;
box on;
exportgraphics(gcf, fullfile(figure_dir,'total_indices.jpg'), ...
'Resolution',300);

% Total-order ranking

[STi_sorted, index] = sort(STi,'descend');

figure;

bar(STi_sorted);

xticks(1:M);
xticklabels(parameter_names(index));

ylabel('Total-order Sobol index, S_{T_i}');
title('Total-Order Sensitivity Ranking');

grid on;
box on;
exportgraphics(gcf, fullfile(figure_dir,'indices_ranking.jpg'), ...
'Resolution',300);

%% One-at-a-time regression analysis
clear;
clc;
close all;
figure_dir = '/Users/jeremywang/Library/CloudStorage/GoogleDrive-jcwang2@caltech.edu/My Drive/HAPS_Guidance/Figures/SAR_uncertainty';

% Baseline parameter values
c = 299792458; % speed of light, m/s
f = 1.2e9; % cycles/sec
lambda = c/f; % meters

baseline.L         = 20;
baseline.lambda    = lambda;      % m
baseline.dphi      = 1;         % degrees
baseline.NESZ_dB   = -20;       % dB
baseline.sigma0_dB = -10;       % dB
baseline.b_perp    = 100;       % m
baseline.time      = 12*3600;   % seconds

sigma_z = estimate_insar_uncertainty(baseline.L, baseline.lambda, baseline.dphi, baseline.NESZ_dB, baseline.sigma0_dB,baseline.b_perp,baseline.time)
% Parameter definitions

parameter_names = { ...
    'lambda', ...
    'L', ...
    'dphi', ...
    'NESZ_dB', ...
    'sigma0_dB', ...
    'b_perp', ...
    'time'};

plot_labels = { ...
    'Wavelength, \lambda (m)', ...
    'Number of looks, L', ...
    'Heading difference, \Delta\phi (degrees)', ...
    'NESZ (dB)', ...
    'Backscatter, \sigma^0 (dB)', ...
    'Perpendicular baseline, B_\perp (m)', ...
    'Temporal separation (hours)'};

% Parameter ranges
parameter_ranges = { ...
    linspace(0.10,0.30,100), ...       % wavelength, m
    1:50, ...                          % number of looks
    linspace(0,5,100), ...            % heading difference, degrees
    linspace(-30,-15,100), ...         % NESZ, dB
    linspace(-25,-3,100), ...          % sigma0, dB
    linspace(0,200,100), ...           % perpendicular baseline, m
    linspace(6,24,100)*3600};          % time, seconds

n_parameters = length(parameter_names);

%% OAT Vertical-uncertainty plots

figure;
tiledlayout(3,3,'TileSpacing','compact','Padding','compact');

for j = 1:n_parameters

    x = parameter_ranges{j};
    n_values = length(x);

    sigma_z = NaN(n_values,1);

    for k = 1:n_values

        % Begin each run at the baseline
        L         = baseline.L;
        lambda    = baseline.lambda;
        dphi      = baseline.dphi;
        NESZ_dB   = baseline.NESZ_dB;
        sigma0_dB = baseline.sigma0_dB;
        b_perp    = baseline.b_perp;
        time      = baseline.time;

        % Change only the selected parameter
        switch parameter_names{j}

            case 'lambda'
                lambda = x(k);

            case 'L'
                L = round(x(k));

            case 'dphi'
                dphi = x(k);

            case 'NESZ_dB'
                NESZ_dB = x(k);

            case 'sigma0_dB'
                sigma0_dB = x(k);

            case 'b_perp'
                b_perp = x(k);

            case 'time'
                time = x(k);
        end

        output = estimate_insar_uncertainty( ...
            L, lambda, dphi, NESZ_dB, ...
            sigma0_dB, b_perp, time, 0);

        sigma_z(k) = output.sigma_z;
    end

    % Convert time to hours for plotting
    x_plot = x(:);

    if strcmp(parameter_names{j},'time')
        x_plot = x_plot/3600;
    end

    % Keep only finite outputs
    valid_sigma = isfinite(x_plot) & isfinite(sigma_z);

    nexttile;

    scatter( ...
        x_plot(valid_sigma), ...
        sigma_z(valid_sigma)*100, ...
        20, ...
        'filled');

    xlabel(plot_labels{j});
    ylabel('\sigma_z (cm)');
    % ylim([0 1]);   % cm
    title(plot_labels{j});

    grid on;
    box on;
end

sgtitle('One-at-a-Time Effects on Vertical Uncertainty');
exportgraphics(gcf, fullfile(figure_dir,'OAT_sensitivity.jpg'), ...
'Resolution',300);

%% Model wrapper

function Y = run_insar_model(X)
%RUN_INSAR_MODEL Runs estimate_insar_uncertainty for every SAFE sample.
%
% Columns of X:
%   1 = wavelength, m
%   2 = number of looks
%   3 = rotational phase difference, degrees
%   4 = NESZ, dB
%   5 = sigma0, dB
%   6 = perpendicular baseline, m
%   7 = time, seconds

    number_of_runs = size(X,1);
    Y = NaN(number_of_runs,1);

    for k = 1:number_of_runs

        lambda    = X(k,1);

        % SAFE samples from a continuous uniform distribution,
        % so round the number of looks to an integer.
        L         = round(X(k,2));

        dphi      = X(k,3);
        NESZ_dB   = X(k,4);
        sigma0_dB = X(k,5);
        b_perp    = X(k,6);
        time      = X(k,7);

        Y_struct = estimate_insar_uncertainty( ...
            L, ...
            lambda, ...
            dphi, ...
            NESZ_dB, ...
            sigma0_dB, ...
            b_perp, ...
            time, ...
            0);
        Y(k) = Y_struct.sigma_z;
    end
end